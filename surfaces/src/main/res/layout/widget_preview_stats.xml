<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview in the widget picker; the placed widget is drawn by Glance. Same look:
     translucent Material You panel, tonal tiles, Expressive shapes. RemoteViews-safe views only. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background" android:clipToOutline="true">
    <ImageView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_glow"
        android:tint="@color/widget_pv_primary" android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp">
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/wp_meldungen" android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_pv_on_surface_variant" android:textSize="12sp" android:maxLines="1" />
        <!-- Spacer (RemoteViews allow no plain View). -->
        <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:layout_width="84dp" android:layout_height="84dp">
                <ImageView
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_shape_cookie" android:tint="@color/widget_pv_primary" android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:text="@string/wp_nine"
                    android:textColor="@color/widget_pv_on_primary" android:textSize="44sp" android:textStyle="bold" android:maxLines="1" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/wp_of_twelve"
                    android:textColor="@color/widget_pv_on_surface" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp"
                    android:max="12" android:progress="9"
                    android:progressTint="@color/widget_pv_primary" android:progressBackgroundTint="@color/widget_pv_track" />
            </LinearLayout>
        </LinearLayout>
        <!-- Spacer (RemoteViews allow no plain View). -->
        <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_pill" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingStart="4dp" android:paddingTop="4dp"
            android:paddingEnd="10dp" android:paddingBottom="4dp">
            <ImageView
                android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/widget_shape_sunny" android:tint="#FFFF9500" android:importantForAccessibility="no" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="@string/wp_streak" android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_pv_on_secondary_container" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
