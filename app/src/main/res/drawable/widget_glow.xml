<?xml version="1.0" encoding="utf-8"?>
<!-- Soft accent glow for a widget corner: white fading out, tinted with the primary role
     by the widget (about 18 % at the center). A gradient, not a blur. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="radial"
        android:centerX="1.0" android:centerY="0.0"
        android:gradientRadius="100%p"
        android:startColor="#2EFFFFFF"
        android:centerColor="#12FFFFFF"
        android:endColor="#00FFFFFF" />
</shape>
