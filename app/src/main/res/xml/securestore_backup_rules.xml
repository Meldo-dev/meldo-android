<?xml version="1.0" encoding="utf-8"?>
<!-- The encrypted secrets (sign-ins) never leave the device: their Keystore key
     can't be copied, so a copy would be useless. The WebView data stays on the
     device too. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app.meldeplanner.securestore.xml" />
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app.meldeplanner.securestore.xml" />
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
